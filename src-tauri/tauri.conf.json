{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tpl-tauri-pnpm",
  "version": "0.0.1",
  "identifier": "com.tpl-tauri-pnpm",
  "build": {
    "frontendDist": "../ui-desktop/dist",
    "devUrl": "http://localhost:25000",
    "beforeDevCommand": "pnpm -F ui-desktop dev",
    "beforeBuildCommand": "pnpm -F ui-desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "tpl-tauri-pnpm",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
